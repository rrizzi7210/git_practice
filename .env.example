# Copy to .env and fill in, or export these in your shell.
# The console hostname or IP (no scheme).
UNIFI_HOST=192.168.1.1

# Preferred: an Integration API key created in the UniFi Network app under
# Settings -> Control Plane -> Integrations.
UNIFI_API_KEY=

# Alternative: a local UniFi OS account (needed for some config endpoints).
UNIFI_USERNAME=
UNIFI_PASSWORD=

# Site id (almost always "default").
UNIFI_SITE=default
